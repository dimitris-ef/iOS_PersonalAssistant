# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# Xcode
*.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/
*.xcuserstate

# CI preview output (generated on the macOS runner, and locally if you run the
# same commands). The .xcodeproj is generated from project.yml, never committed.
.ci-deriveddata/
artifacts/

# Development harness storage — may contain personal data
devdata/
*.assistant-store/

# Secrets. API keys belong in the keychain, never in the repo.
# Config/LocalSecrets.example.xcconfig IS committed; the real one never is.
Config/LocalSecrets.xcconfig
.env
*.pem
*.p12
*.mobileprovision
secrets.json

# macOS
.DS_Store
