<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The App Group the widgets and the keyboard share with the app.
	     Must match SystemSurfaceIdentifiers.appGroup; a test asserts it does,
	     because a mismatch resolves to nil rather than to an error. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.dimitrisefthymiou.MetisAI</string>
	</array>
</dict>
</plist>
