<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  The target sets GENERATE_INFOPLIST_FILE=NO, so every key the system needs
	  has to be here. Without CFBundleIdentifier and CFBundleExecutable the
	  built bundle has no identifier, and `simctl install` / `simctl launch`
	  cannot address it.
	-->
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>Assistant</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!--
	  Development-only remote AI configuration, injected from
	  Config/LocalSecrets.xcconfig when that file exists. Blank otherwise —
	  including in CI. Values entered in Settings always take priority, and the
	  API key entered there goes to the keychain, not here.
	-->
	<key>RemoteAIBaseURL</key>
	<string>$(REMOTE_AI_BASE_URL)</string>
	<key>RemoteAIModel</key>
	<string>$(REMOTE_AI_MODEL)</string>
	<key>RemoteAIAPIKey</key>
	<string>$(REMOTE_AI_API_KEY)</string>

	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>

	<!--
	  Usage descriptions for the capabilities the assistant will request.
	  They are declared now so the strings are reviewed as product copy rather
	  than written in a hurry the day the integration lands. None of these
	  permissions is requested by the current build.
	  TODO-XCODE: verify each string once the matching integration exists.
	-->
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>The assistant adds the appointments you tell it about and reads what is coming up so it can remind you in time.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>The assistant keeps your reminders in step with the tasks it is tracking for you.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Speak to the assistant instead of typing.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Your speech is turned into text so the assistant can act on what you said.</string>
</dict>
</plist>
