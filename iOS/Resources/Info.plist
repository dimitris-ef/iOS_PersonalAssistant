<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  The target sets GENERATE_INFOPLIST_FILE=NO, so every key the system needs
	  has to be here. Without CFBundleIdentifier and CFBundleExecutable the
	  built bundle has no identifier, and `simctl install` / `simctl launch`
	  cannot address it.
	-->
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>Assistant</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!--
	  Development-only remote AI configuration, injected from
	  Config/LocalSecrets.xcconfig when that file exists. Blank otherwise —
	  including in CI. Values entered in Settings always take priority, and the
	  API key entered there goes to the keychain, not here.
	-->
	<key>RemoteAIBaseURL</key>
	<string>$(REMOTE_AI_BASE_URL)</string>
	<key>RemoteAIModel</key>
	<string>$(REMOTE_AI_MODEL)</string>
	<key>RemoteAIAPIKey</key>
	<string>$(REMOTE_AI_API_KEY)</string>

	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>

	<!--
	  Usage descriptions. Each one is the sentence shown in the system
	  permission alert, so each says what this app does with the access and
	  why — not what the API is called.

	  Every key below now backs a real request. iOS terminates the app, with no
	  recoverable error, if a framework asks for access and the matching key is
	  missing, so the list and the code have to agree exactly.

	  There is deliberately no notification key: UserNotifications has none.
	  Its permission alert is written by the system and cannot be customised,
	  which is why the app asks for it at the moment it has a reminder to
	  schedule rather than at launch — the context has to come from what the
	  user just did, because it cannot come from the alert.
	-->

	<!--
	  Full calendar access, not write-only. The assistant reads what is already
	  on the day before it agrees to anything; with add-only access it would
	  answer "you're free at three" to someone who is not. Write-only is
	  requested nowhere, but the user can still choose "Add Events Only" at the
	  prompt, and the app reports that as partial access rather than treating
	  it as a yes.
	-->
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>The assistant adds the appointments you tell it about and reads what is coming up so it can remind you in time.</string>
	<!--
	  Declared because iOS shows it when someone picks "Add Events Only" at the
	  full-access prompt. Without it that path has no explanation on screen.
	-->
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>The assistant adds the appointments you tell it about to your calendar.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>The assistant keeps your reminders in step with the tasks it is tracking for you.</string>
	<!--
	  AlarmKit, on iOS 26 and later. Asked for only when something actually
	  needs an alarm rather than a notification — "make sure I wake up" — and
	  on earlier iPhones the request never happens because the framework is not
	  there.
	-->
	<key>NSAlarmKitUsageDescription</key>
	<string>The assistant sets alarms for the things you told it you must not sleep through.</string>
	<!--
	  Voice. Both are requested contextually, the first time the user taps the
	  microphone — never at launch. The microphone alert comes first; if it is
	  declined the speech-recognition alert is not shown at all, because
	  recognition without a microphone is useless and two refusals in a row is
	  worse than one.

	  Both keys are required by the implementation: `AVAudioApplication` for
	  capture and `SFSpeechRecognizer` for transcription. Audio is transcribed
	  and the buffers released — nothing is recorded to disk, and no audio ever
	  reaches an AI provider.
	-->
	<key>NSMicrophoneUsageDescription</key>
	<string>Personal Assistant uses the microphone when you choose to speak to the assistant.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>What you say is turned into text so the assistant can act on it. Your recordings are not saved.</string>
	<!--
	  Background reliability.

	  `fetch` is the only background mode this app declares, and it is worth
	  saying what it is *not* for: reminders. Those are scheduled with
	  UNUserNotificationCenter and AlarmKit, which iOS delivers whether or not
	  this process exists — that is the whole architecture, and it is why the
	  app does not need to keep running.

	  What the refresh buys is an *earlier* correction. When a reminder has been
	  ignored, the app has to run again before it can notice and escalate; a
	  granted refresh means that can happen before the user next opens the app
	  rather than only when they do. iOS decides whether and when to grant one,
	  based on battery, charging and how often the app is used, so nothing about
	  correctness may depend on it — and nothing does.

	  No `processing`, no `audio`, no `location`. Adding a background mode the
	  app does not genuinely need is both an App Review problem and a battery
	  one, and none of them would make a notification arrive any more reliably.
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<!--
	  Every identifier the app may register with BGTaskScheduler. iOS matches
	  registrations against this list at launch and traps on a mismatch, so the
	  string here and the constant in `AppLifecycleCoordinator` must agree.
	-->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.example.personalassistant.refresh</string>
	</array>
</dict>
</plist>
