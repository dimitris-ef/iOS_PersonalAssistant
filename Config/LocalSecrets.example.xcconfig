// Template for development configuration. Copy to LocalSecrets.xcconfig and
// fill it in:
//
//     cp Config/LocalSecrets.example.xcconfig Config/LocalSecrets.xcconfig
//
// LocalSecrets.xcconfig is gitignored. This template never is — keep every
// value here a placeholder.
//
// This is a DEVELOPMENT convenience. Values here are compiled into the app's
// Info.plist, so a real key placed in this file ends up inside the built
// bundle. Never use it for anything you would not paste into a build log, and
// never for a distribution build. For normal use, enter the key in
// Settings → AI Model → Remote AI, which stores it in the keychain instead.
//
// IMPORTANT — no "//" in values. xcconfig treats "//" as a comment, so a URL
// written as https://api.example.com would be truncated. Write the host
// WITHOUT the scheme; the app assumes HTTPS for a bare host.
//
//     wrong: REMOTE_AI_BASE_URL = https://api.openai.com/v1
//     right: REMOTE_AI_BASE_URL = api.openai.com/v1

REMOTE_AI_BASE_URL = api.openai.com/v1
REMOTE_AI_MODEL = YOUR_MODEL_NAME
REMOTE_AI_API_KEY = YOUR_API_KEY_HERE
